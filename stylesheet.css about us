    /* Base Page Styling */
    body {
      font-family: Arial, Helvetica, sans-serif;
      background-color: #e5e5e5;
      margin: 0;
      padding: 20px;
      color: #000;
    }

    .page-container {
      max-width: 500px;
      margin: 0 auto;
    }

    /* Title Header Banner */
    .title-banner {
      background-color: #b0b0b0;
      border-radius: 40px;
      padding: 15px 20px;
      text-align: center;
      margin-bottom: 15px;
    }

    .title-banner h1 {
      margin: 0;
      font-size: 2.5rem;
      font-weight: bold;
      color: #000;
    }


    .nav-bar {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 20px;
    }

    .nav-btn {
      flex: 1;
      background-color: #b0b0b0;
      color: #000;
      text-decoration: none;
      text-align: center;
      padding: 12px 0;
      border-radius: 12px;
      font-size: 1.2rem;
      font-weight: bold;
    }

    .nav-btn.active {
      background-color: #8c8c8c;
    }


    .about-subheading {
      text-align: center;
      font-size: 1.1rem;
      font-weight: bold;
      margin: 15px 0 10px 0;
    }

    .diagram-box img {
      width: 100%;
      border-radius: 4px;
      display: block;
      margin-bottom: 15px;
    }

    .card-box {
      background-color: #b0b0b0;
      border-radius: 20px;
      padding: 18px;
      font-size: 0.95rem;
      font-weight: bold;
      line-height: 1.35;
    }

    .card-box p {
      margin: 0;
    }


    .contact-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .oval-card {
      background-color: #b0b0b0;
      border-radius: 60px; /* Gives the pill/oval card shape */
      padding: 15px 25px;
      display: flex;
      align-items: center;
      justify-content: space-around;
    }

    .oval-card img {
      width: 90px;
      height: 90px;
      object-fit: contain;
    }

    .oval-card p {
      margin: 0;
      font-size: 1.2rem;
      font-weight: bold;
      color: #000;
    }

